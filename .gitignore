# OS cruft
.DS_Store

# Syncthing runtime markers (created inside the synced folder; never commit)
.stfolder/
.stversions/

# Runtime/generated artifacts. With the per-package layout these regenerate at
# their real ~ locations and normally never appear in the repo; listed here as
# defense-in-depth so they can never be committed by accident.
btop/.config/btop/btop.log
hunk/.config/hunk/state.json
herdr/.config/herdr/session.json
herdr/.config/herdr/*.log
fish/.config/fish/fisher/
fish/.config/fish/fish_variables
fish/.config/fish/local.fish
tmux/.config/tmux/plugins/
nvim/.config/nvim/plugin/
nvim/.config/nvim/spell/
