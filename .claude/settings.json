{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name' | sed -E 's/[[:space:]]+[0-9]+(\\.[0-9]+)*$//'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf '\\033[2m[%s] %.0f%%\\033[0m' \"$model\" \"$used\"; else printf '\\033[2m[%s]\\033[0m' \"$model\"; fi"
  },
  "enabledPlugins": {
    "ty-lsp@local": true,
    "ruff-lsp@local": true,
    "commit-commands@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playground@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "local": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins/local"
      }
    }
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "spinnerTipsEnabled": false
}
