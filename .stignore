// Syncthing ignore list for the dotfiles folder.
// The laptop is the source of truth and the only machine with a real .git;
// Syncthing mirrors the working tree to remotes WITHOUT git internals.

// Never sync git internals — prevents repo corruption and .sync-conflict files.
.git

// OS cruft
.DS_Store

// Syncthing's own runtime markers (auto-ignored anyway; listed for clarity).
.stfolder
.stversions

// Runtime/generated artifacts — mirror of .gitignore. These regenerate at their
// real ~ locations per machine and must never propagate between machines.
/btop/.config/btop/btop.log
/hunk/.config/hunk/state.json
/fish/.config/fish/fisher
/fish/.config/fish/fish_variables
/fish/.config/fish/local.fish
/tmux/.config/tmux/plugins
/nvim/.config/nvim/plugin
/nvim/.config/nvim/spell
