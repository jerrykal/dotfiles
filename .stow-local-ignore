# GNU Stow ignore list — Perl REGULAR EXPRESSIONS, one per line (NOT gitignore globs).
#
# Stow has NO "!" un-ignore syntax; gitignore-style allow-lists silently do nothing.
# An allow-list must instead be written as a single negative-lookahead regex.
#
# Matching (see manual link below):
#   - A line WITHOUT "/" is matched against the basename (anchored, exact), anywhere in the tree.
#   - A line WITH "/" is matched against any subpath of the "/"-prefixed path relative to the
#     repo root (anchored, exact). e.g. .claude/scripts/notify.sh -> "/.claude/scripts/notify.sh".
# https://www.gnu.org/software/stow/manual/html_node/Types-And-Syntax-Of-Ignore-Lists.html
#
# (.stow-local-ignore itself is always ignored by stow automatically.)

# --- Repo metadata (basename match, anywhere in tree) ---
\.git
\.gitignore
\.DS_Store
\.stfolder
\.stignore
\.stversions

# --- Top-level project files (root-anchored so .claude/CLAUDE.md is NOT caught) ---
^/CLAUDE\.md$
^/README.*
^/Brewfile$
^/install\.sh$

# --- .claude: stow ONLY CLAUDE.md, settings.json, scripts/, skills/ ---
^/\.claude/(?!(scripts|skills)(/|$)|(CLAUDE\.md|settings\.json)$).+

# --- .local/bin: stow ONLY the tracked helper scripts ---
^/\.local/bin/(?!(pf|tmux-sesh|tmux-opencode)$).+

# --- Generated artifacts present in the tree but must never be symlinked ---
^/\.config/fish/fisher$
^/\.config/fish/fish_variables$
^/\.config/tmux/plugins$
^/\.config/nvim/plugin$
^/\.config/nvim/spell$
