#!/usr/bin/env bash
# tmux-ref — yank from tmux copy mode with the scrollback location attached.
#
#   tmux-ref yank <pane-id> <sel-start> <sel-end>   # selection on stdin
#
# Backs the Y key in copy-mode-vi (tmux.conf). It snapshots the pane's whole
# scrollback into $XDG_STATE_HOME/tmux-ref and puts the selection on the
# clipboard behind a header that names the snapshot, the rows the selection
# occupies in it, and the live pane, so pasting that into an agent is enough
# for the agent to read the surrounding output with sed and to check the pane
# for anything printed since.
#
# Row numbers are tmux grid indices — 0 is the oldest line still in history —
# and the snapshot is capture-pane's grid, so row N of the selection is line N
# of the file, for good: the file never moves the way the live pane does once
# its history fills up and starts dropping its oldest lines.

set -euo pipefail

us=$'\x1f'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-ref"
scratch=()

cleanup() {
  ((${#scratch[@]})) && rm -f -- "${scratch[@]}"
  return 0
}
trap cleanup EXIT

# Under `send -X pipe` the tmux server owns stderr and throws it away, so a
# failing Y would otherwise look like a dead key.
die() {
  printf 'tmux-ref: %s\n' "$*" >&2
  tmux display-message "tmux-ref: $*"
  exit 1
}

cmd_yank() {
  local pane=${1:-} start=${2:-} end=${3:-}
  [[ $pane == %* && $start =~ ^[0-9]+$ && $end =~ ^[0-9]+$ ]] ||
    die "usage: tmux-ref yank <pane-id> <sel-start> <sel-end>"
  # A selection dragged upwards reports its ends the other way round.
  if ((start > end)); then
    local swap=$start
    start=$end
    end=$swap
  fi

  # The trailing `.` survives the newline stripping that command substitution
  # would otherwise do, so blank rows at the end of a selection are kept.
  local text
  text=$(
    cat
    printf .
  )
  text=${text%.}
  [[ -n $text ]] || die "nothing selected"

  local info server sess win win_name pane_idx cmd path
  info=$(tmux display-message -p -t "$pane" \
    "#{pid}$us#{session_name}$us#{window_index}$us#{window_name}$us#{pane_index}$us#{pane_current_command}$us#{pane_current_path}")
  IFS="$us" read -r server sess win win_name pane_idx cmd path <<<"$info"

  # Spelt out rather than as ${path/#$HOME/~}, whose replacement bash 5.2 tilde-
  # expands straight back into $HOME while bash 3.2 keeps the backslash that
  # would suppress it.
  case $path in "$HOME"/*) path="~${path#"$HOME"}" ;; esac

  # Pane ids restart at %0 with every new tmux server, so the server's pid
  # keeps one server's snapshots apart from another's; the timestamp keeps two
  # yanks from the same pane apart, since each points at the pane as it was.
  mkdir -p "$state_dir"
  local snap tmp
  snap="$state_dir/$server-${pane#%}-$(date '+%Y%m%dT%H%M%S').txt"
  tmp=$(mktemp "$state_dir/.tmp.XXXXXX")
  scratch+=("$tmp")
  tmux capture-pane -p -t "$pane" -S - -E - >"$tmp" ||
    die "could not capture $pane"
  mv -f -- "$tmp" "$snap"
  local home_snap=$snap
  case $snap in "$HOME"/*) home_snap="~${snap#"$HOME"}" ;; esac
  find "$state_dir" -type f -mtime +14 -delete 2>/dev/null || true

  # Piped rather than passed as an argument: tmux caps a command at 16KB, which
  # a yank of a screenful of output already exceeds.
  local ref="$pane:$start-$end"
  {
    printf '%s\n' \
      "tmux-ref $ref — $sess:$win.$pane_idx \"$win_name\" ($cmd) in $path, $(date '+%Y-%m-%d %H:%M')" \
      "scrollback as of the copy, rows 0-based: $home_snap (e.g. sed -n '$((start > 40 ? start - 39 : 1)),$((end + 41))p')" \
      "live pane, for anything printed since: tmux capture-pane -p -t $pane -S - -E -" \
      "----- copied text -----"
    printf '%s' "$text"
    [[ $text == *$'\n' ]] || printf '\n'
    printf '%s\n' "----- end -----"
  } | tmux load-buffer -w -

  tmux display-message "copied $(printf '%s' "$text" | awk 'END{print NR}') line(s) as $ref"
}

case ${1:-} in
yank)
  shift
  cmd_yank "$@"
  ;;
-h | --help | '') printf 'tmux-ref yank <pane-id> <sel-start> <sel-end>   # selection on stdin\n' ;;
*) die "unknown command: $1" ;;
esac
