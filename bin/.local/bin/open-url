#!/bin/sh
# open-url — open a URL in the browser of the machine you're sitting at.
#
# Local session: hands the URL to `open` (macOS) / `xdg-open` (Linux).
# SSH session:   sends it to $OPEN_URL_SOCK, a per-user Unix socket that ssh
#                reverse-forwards (RemoteForward in ~/.ssh/config) back to the
#                laptop's launchd listener (local.open-url). A socket (not a
#                TCP port) lets multiple concurrent sessions coexist without
#                the "remote port forwarding failed" warning.
# --listen:      handler spawned by launchd per connection (inetd-style,
#                stdin = socket); reads one URL and opens it if http(s).
#
# Manual setup (~/.ssh/config is machine-local, NOT in the dotfiles repo — add
# this by hand on each client machine you ssh *from*):
#
#     Host *
#         # open-url: remote `open-url <url>` opens in this machine's browser.
#         # A per-user Unix socket (%r = remote user) lets a 2nd+ concurrent
#         # session re-bind cleanly instead of failing "remote port forwarding
#         # failed for listen port 41999"; StreamLocalBindUnlink hands the stale
#         # socket to the newest session. All sessions target the same laptop
#         # listener, so newest-wins is harmless. Keep the path in sync with
#         # $OPEN_URL_SOCK below.
#         RemoteForward /tmp/open-url-%r.sock 127.0.0.1:41999
#         StreamLocalBindUnlink yes
#
# The laptop end is the launchd listener (local.open-url) on TCP 41999.

sock="${OPEN_URL_SOCK:-/tmp/open-url-$(id -un).sock}"

if [ "${1:-}" = "--listen" ]; then
    IFS= read -r url || exit 0
    case $url in
    http://* | https://*) exec open "$url" ;;
    *) printf 'open-url: ignoring non-http(s) input: %s\n' "$url" >&2 ;;
    esac
    exit 0
fi

if [ $# -ne 1 ]; then
    echo "usage: open-url <url>" >&2
    exit 1
fi
url=$1

if [ -n "${SSH_CONNECTION:-}" ]; then
    if [ -S "$sock" ]; then
        if command -v nc >/dev/null 2>&1 &&
            printf '%s\n' "$url" | nc -U -w 2 "$sock" 2>/dev/null; then
            exit 0
        elif command -v socat >/dev/null 2>&1 &&
            printf '%s\n' "$url" | socat -t 2 - "UNIX-CONNECT:$sock" 2>/dev/null; then
            exit 0
        elif command -v python3 >/dev/null 2>&1 && printf '%s\n' "$url" |
            python3 -c 'import socket,sys
s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1])
s.sendall(sys.stdin.buffer.read()); s.close()' "$sock" 2>/dev/null; then
            exit 0
        fi
    fi
    echo "open-url: no forwarded listener at $sock (RemoteForward missing?)" >&2
fi

if command -v open >/dev/null 2>&1; then
    exec open "$url"
elif command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$url"
fi
echo "open-url: no way to open '$url' here" >&2
exit 1
