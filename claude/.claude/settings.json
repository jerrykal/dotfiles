{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "astral@astral-sh": true,
    "context-mode@context-mode": true,
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "0.5"
  },
  "extraKnownMarketplaces": {
    "astral-sh": {
      "autoUpdate": true,
      "source": {
        "repo": "astral-sh/claude-code-plugins",
        "source": "github"
      }
    },
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "TITLE='Claude Code' BODY=$(jq -r '.message // \"Notification\"') ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "^(?!idle_prompt$).*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/block-dangerous-git.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/context-mode-cache-heal.mjs",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/home/jerrylee/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/jerrylee/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "TITLE='Claude Code' BODY='Task complete' ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "TITLE='Claude Code' BODY='Task failed' ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus",
  "permissions": {
    "ask": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env*)",
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)",
      "Read(**/config/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Write(**/.env*)",
      "Write(**/secrets/**)",
      "Write(**/.ssh/**)",
      "Write(.github/workflows/*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "custom:rose-pine",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  }
}